apiVersion: v1
kind: Secret
metadata:
  name: nitrocore-secrets
  namespace: rigby-host
type: Opaque
stringData:
  POSTGRES_PASSWORD: "YOUR_POSTGRES_PASSWORD"
  REDIS_URL: "redis://default:YOUR_REDIS_PASSWORD@rigby-host-redis-master.rigby-host.svc.cluster.local:6379/0"
  S3_ACCESS_KEY: "YOUR_S3_ACCESS_KEY"
  S3_SECRET: "YOUR_S3_SECRET"
